# Container deployment
APP_IMAGE=crpi-u11hdbc769825d1d.cn-hangzhou.personal.cr.aliyuncs.com/sxlisme/ts-live-lab:latest
BIND_ADDRESS=127.0.0.1
WEB_PORT=8787

# API server
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=false
HTTPS_ONLY=false
ALLOWED_ORIGIN=https://ts.example.com

# Preferred production setup: keep the Claude key on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# Allow users to provide a temporary key from the settings page.
# Keep this false for a public deployment with a server-owned key.
ALLOW_CLIENT_AI_KEY=true

# Allow a browser-owned key to use another public HTTPS Anthropic-compatible endpoint.
# Server-owned keys are always locked to ANTHROPIC_BASE_URL.
ALLOW_CLIENT_AI_BASE_URL=true

# Optional comma-separated exact base URL allowlist. Empty allows any validated public HTTPS host.
AI_ALLOWED_BASE_URLS=
